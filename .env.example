# Copy to .env and adjust. Never commit the real .env file.

# --- Production only (see DEPLOY.md) ---
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# DOMAIN=tickets.example.com
# Production starts without demo data unless this is true:
# SEED_DEMO_DATA=true

# --- PostgreSQL ---
POSTGRES_USER=krunchbox
POSTGRES_PASSWORD=krunchbox
POSTGRES_DB=krunchbox

# --- API ---
ENVIRONMENT=development
# In production this must be a random string of 32+ characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-before-deploying
JWT_EXPIRE_MINUTES=60

# Minutes a reservation is held before its tickets are released.
# Tip for demos: set it to 1 to show a reservation expiring live.
RESERVATION_TTL_MINUTES=10

# --- Accounts created on first start ---
# Demo values, public in this repository: always change them before deploying.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin-demo-1234
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo-demo-1234
